# Curatarr configuration template.
#
# You normally do NOT create this file by hand: the Setup Wizard writes a
# real .env on first run. This template documents every setting for manual
# setups and for reference. Copy to `.env` and fill in the blanks.
# Defaults shown here mirror src/config.py — omit a line to keep its default.

# ── App ────────────────────────────────────────────────────────────────────
# HOST is the BIND address only (0.0.0.0 = serve the whole LAN).
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Set to false by the setup wizard after completion.
FIRST_RUN=true

# ── Security (required) ────────────────────────────────────────────────────
# Long random string; the setup wizard generates one for you.
JWT_SECRET=

# ── Plex (required) ────────────────────────────────────────────────────────
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=
PLEX_CLIENT_ID=Curatarr
# Must match how your browser reaches Curatarr (host:port).
PLEX_REDIRECT_URI=http://localhost:8000

# ── Ollama (required — local LLM runtime) ──────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
# Baked model names created by `python build_models.py` — leave as-is.
CURATOR_MODEL=curatarr-curator
SUMMARIZER_MODEL=curatarr-summarizer
# Base models the bakes are built FROM (.env is the single source of truth).
# gemma4:31b is the benchmarked default (~19 GB — needs a 24 GB GPU); on
# smaller cards pick a smaller base and expect softer verdicts.
BASE_CURATOR_MODEL=gemma4:31b
BASE_SUMMARIZER_MODEL=granite4.1:8b
# Smaller fallbacks used when the primary is unavailable or VRAM-constrained.
BACKUP_CURATOR_MODEL=
BACKUP_SUMMARIZER_MODEL=granite4.1:3b
# Optional dedicated deletion-run bake (two-bake split). Empty = disabled.
PITCHER_MODEL=
BASE_PITCHER_MODEL=qwen3.8:27b
# Embedding model (legacy fallback — the active model lives in the app's
# embedding profile).
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Strip <think> blocks from LLM output (only needed for reasoning models).
LLM_THINK_TAGS=false
# Concurrent big-model generations server-wide; raise only with spare VRAM.
MAX_CONCURRENT_CURATOR=1

# ── Feature flags ──────────────────────────────────────────────────────────
# 4-pillar LLM judge for deletion proposals — the intended mode; the legacy
# taste-mismatch pitch only remains as a fallback for constrained setups.
PILLARS_ENABLED=true
# Capture curation principles from debates (shadow mode until promoted).
PRINCIPLES_ENABLED=true
# Let NEW/REFINEMENT principles activate automatically (contradictions wait).
PRINCIPLE_AUTO_ACTIVATE=false

# ── ARR services (each pair optional) ──────────────────────────────────────
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
SONARR_URL=http://localhost:8989
SONARR_API_KEY=
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# ── Metadata APIs ──────────────────────────────────────────────────────────
# TMDB strongly recommended; the rest optional. AniList + MusicBrainz need
# no key.
TMDB_API_KEY=
# Free at omdbapi.com (1000 req/day) — ratings + awards backfill.
OMDB_API_KEY=
# OpenSubtitles (optional) — dialogue signals for titles whose Plex copy has
# no downloadable subtitle file. Free key at opensubtitles.com; the free tier
# allows only a handful of downloads per day, a VIP account 1000. Username and
# password are optional and only serve to claim your account's larger quota.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Stay under your account's real cap if another tool (Bazarr, …) shares it.
OPENSUBTITLES_DAILY_BUDGET=400
# Optional self-hosted subtitle service. Nothing is bundled and no public
# archive is contacted; leave blank unless you run such a service yourself.
# The expected HTTP contract is documented in src/services/subtitle_provider.py.
SUBTITLE_PROVIDER_URL=
SUBTITLE_PROVIDER_API_KEY=
# Music tags + similar artists.
LASTFM_API_KEY=
# Client-credentials flow — no user login needed (developer.spotify.com).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SoulSync (optional LAN neighbour, read-only music metadata consumer).
SOULSYNC_URL=
SOULSYNC_API_KEY=

# ── Sync ───────────────────────────────────────────────────────────────────
SYNC_ON_STARTUP=true
SYNC_INTERVAL_HOURS=24

# ── Binge detection ────────────────────────────────────────────────────────
BINGE_EPISODE_THRESHOLD=3
BINGE_SESSION_HOURS=6
BINGE_SERIES_PERCENT=0.5

# ── Enrichment & game-pause ────────────────────────────────────────────────
ENRICHMENT_TTL_DAYS=90
ENRICHMENT_REFRESH_BATCH_SIZE=150
ARR_PRE_ENRICH_BATCH=80
# Extra game .exe names, comma-separated (pauses GPU work while you play).
EXTRA_GAME_PROCESSES=

# ── CORS / API surface ─────────────────────────────────────────────────────
# JSON list; add your LAN origin if users browse via server IP.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Swagger/ReDoc off by default (the app binds to the LAN — /api/docs would
# hand out a map of every endpoint). Enable only for development.
ENABLE_DOCS=false

# ── Storage paths (defaults anchor to the app root; override only if you
#    know why) ─────────────────────────────────────────────────────────────
#DATABASE_URL=sqlite:///data/curatarr.db
#CHROMADB_PATH=data/chromadb
#ENRICHMENT_CACHE=data/cache/enrichment.db
