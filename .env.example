# Curatarr configuration template.
#
# You normally do NOT create this file by hand: the Setup Wizard writes a
# real .env on first run. This template documents every setting for manual
# setups and for reference. Copy to `.env` and fill in the blanks.
# Defaults shown here mirror src/config.py — omit a line to keep its default.

# ── App ────────────────────────────────────────────────────────────────────
# HOST is the BIND address only (0.0.0.0 = serve the whole LAN).
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Set to false by the setup wizard after completion.
FIRST_RUN=true
# Ask GitHub (anonymously, at most hourly) whether a newer build exists;
# admins then see "Update available" under the sidebar. Sends no library data.
UPDATE_CHECK=true

# ── Security (required) ────────────────────────────────────────────────────
# Long random string; the setup wizard generates one for you.
JWT_SECRET=

# ── Plex (required) ────────────────────────────────────────────────────────
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=
# Identifies this install to plex.tv. Leave blank: the setup wizard gives a
# fresh install its own random id. Do not change it on a running install -
# Plex sees a new device and stored sign-ins were issued to the old one.
PLEX_CLIENT_ID=
# Must match how your browser reaches Curatarr (host:port).
PLEX_REDIRECT_URI=http://localhost:8000
# New sign-ins must be accounts this Plex server knows (owner, Plex Home,
# shared friends), and the first one must own the server. Turn off only if
# the server's /accounts list misses a legitimate member.
PLEX_LOGIN_REQUIRE_MEMBERSHIP=true

# ── Ollama (required — local LLM runtime) ──────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
# Baked model names created by `python build_models.py` — leave as-is.
CURATOR_MODEL=curatarr-curator
SUMMARIZER_MODEL=curatarr-summarizer
# Base models the bakes are built FROM (.env is the single source of truth).
# gemma4:31b is the benchmarked default (~19 GB — needs a 24 GB GPU); on
# smaller cards pick a smaller base and expect softer verdicts.
BASE_CURATOR_MODEL=gemma4:31b
BASE_SUMMARIZER_MODEL=granite4.1:8b
# Reserved for a fallback model. Nothing reads these yet: switching models
# means changing BASE_* above and re-running build_models.py.
BACKUP_CURATOR_MODEL=
BACKUP_SUMMARIZER_MODEL=granite4.1:3b
# Optional dedicated deletion-run bake (two-bake split). Empty = disabled.
PITCHER_MODEL=
BASE_PITCHER_MODEL=qwen3.8:27b
# Embedding model (legacy fallback — the active model lives in the app's
# embedding profile).
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Strip <think> blocks from LLM output (only needed for reasoning models).
LLM_THINK_TAGS=false
# Concurrent big-model generations server-wide; raise only with spare VRAM.
MAX_CONCURRENT_CURATOR=1
# Hardware profile: "large" (24 GB card, 27-31B curator, 16k context) or
# "small" (8-12 GB card, 8B-14B curator: 8k context and a compact checklist
# constitution for the deletion judge). `python build_models.py --check`
# warns when the curator will not fit the card.
LLM_PROFILE=large
# Curator context window in tokens; 0 = the profile's default. Re-run
# `python build_models.py` after changing it.
CURATOR_NUM_CTX=0
# Curator layers on the GPU: 99 = all; -1 = let Ollama split the model across
# GPU and CPU when it does not fit (slower, but it loads).
CURATOR_NUM_GPU=99
# use_mmap for OLLAMA_ENDPOINT. Unset = Ollama decides. true stops Ollama on
# Linux from keeping a second copy of the summariser in RAM; leave it unset
# for Ollama on Windows with CUDA, which turns mmap off on purpose. (Remove
# the line rather than leave it blank: a blank boolean stops the server.)
#OLLAMA_USE_MMAP=true
# Build missing curatarr-* models in the background after start. The
# container image sets this; on the desktop start.bat builds them instead.
AUTO_BUILD_MODELS=false

# ── Sharing the GPU ────────────────────────────────────────────────────────
# A GPU saturated by something other than Ollama (an image job, a benchmark)
# counts as a game: LLM-heavy background work yields.
GPU_PRESSURE_GATE=true
# While another program holds the GPU, summariser work (enrichment, memory,
# taste) runs on the CPU instead of stopping; chat and deletion runs wait.
LLM_CPU_LANE=true
# Threads for that CPU lane (six are as fast as twelve: it is memory-bound).
LLM_CPU_THREADS=6
# The lane stays closed below this much free RAM (one run needs ~10 GB).
LLM_CPU_MIN_FREE_MB=12000

# ── Feature flags ──────────────────────────────────────────────────────────
# 4-pillar LLM judge for deletion proposals — the intended mode; the legacy
# taste-mismatch pitch only remains as a fallback for constrained setups.
PILLARS_ENABLED=true
# Capture curation principles from debates (shadow mode until promoted).
PRINCIPLES_ENABLED=true
# Let NEW/REFINEMENT principles activate automatically (contradictions wait).
PRINCIPLE_AUTO_ACTIVATE=false

# ── ARR services (each pair optional) ──────────────────────────────────────
RADARR_URL=http://localhost:7878
RADARR_API_KEY=
SONARR_URL=http://localhost:8989
SONARR_API_KEY=
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=
# Seconds a full library listing may take (Lidarr computes per-artist stats
# first: ~2 min on 5,000 artists). A down arr still fails within 10 s.
#ARR_LISTING_TIMEOUT_S=240

# ── Metadata APIs ──────────────────────────────────────────────────────────
# TMDB strongly recommended; the rest optional. AniList + MusicBrainz need
# no key.
TMDB_API_KEY=
# Free at omdbapi.com (1000 req/day) — ratings + awards backfill.
OMDB_API_KEY=
# Calls per day before OMDb lookups wait for tomorrow (free tier: 1000).
OMDB_DAILY_LIMIT=1000
# MyAnimeList client id (optional, free at myanimelist.net/apiconfig, app type
# "other"): anime scores, genres and the title search when AniList misses.
# Without it Curatarr asks Jikan, which has been down since 2026-08-28.
MAL_CLIENT_ID=
# OpenSubtitles (optional) — dialogue signals for titles whose Plex copy has
# no downloadable subtitle file. Free key at opensubtitles.com; the free tier
# allows only a handful of downloads per day, a VIP account 1000. Username and
# password are optional and only serve to claim your account's larger quota.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
# Stay under your account's real cap if another tool (Bazarr, …) shares it.
OPENSUBTITLES_DAILY_BUDGET=400
# Optional self-hosted subtitle service. Nothing is bundled and no public
# archive is contacted; leave blank unless you run such a service yourself.
# The expected HTTP contract is documented in src/services/subtitle_provider.py.
# Base URL. A bare host gets /api/v1 appended; give a full base if your
# service uses a different prefix.
SUBTITLE_PROVIDER_URL=
SUBTITLE_PROVIDER_API_KEY=
# Music tags + similar artists.
LASTFM_API_KEY=
# Client-credentials flow — no user login needed (developer.spotify.com).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SoulSync (optional LAN neighbour, read-only music metadata consumer).
SOULSYNC_URL=
SOULSYNC_API_KEY=
# ListenBrainz global popularity for music evidence. A free account token is
# required (listenbrainz.org/settings); blank = the signal is skipped.
LISTENBRAINZ_TOKEN=

# ── Sync ───────────────────────────────────────────────────────────────────
SYNC_ON_STARTUP=true
SYNC_INTERVAL_HOURS=24

# ── Binge detection ────────────────────────────────────────────────────────
BINGE_EPISODE_THRESHOLD=3
BINGE_SESSION_HOURS=6
BINGE_SERIES_PERCENT=0.5

# ── Enrichment & game-pause ────────────────────────────────────────────────
ENRICHMENT_TTL_DAYS=90
ENRICHMENT_REFRESH_BATCH_SIZE=150
ARR_PRE_ENRICH_BATCH=80
# Extra game .exe names, comma-separated (pauses GPU work while you play).
EXTRA_GAME_PROCESSES=
# Rebuild the facet search index when a quarter of it is dead slots. Saves
# memory, but the rebuilt index finds fewer neighbours, so it stays off until
# a rebuild keeps the recall.
FACET_COMPACT=false

# ── CORS / API surface ─────────────────────────────────────────────────────
# JSON list; add your LAN origin if users browse via server IP.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Optional DNS-rebinding guard: the host names this server answers to,
# comma-separated, without port; "*.example.com" wildcards allowed. Any other
# Host header gets 400. localhost / 127.0.0.1 / ::1 always work. Empty = no
# check (default). List every name you browse by (IP, hostname, proxy name).
#ALLOWED_HOSTS=192.168.1.20,curatarr.lan,*.home.example.com
ALLOWED_HOSTS=
# Published through Cloudflare Access + a reverse proxy? Name the public
# host(s) here: requests under them must carry a valid Access token, so the
# proxy can't be reached around Cloudflare. LAN names are never checked.
# Team domain and the Access application's audience (AUD) tag are both
# required; a listed host without them refuses everything.
#CF_ACCESS_HOSTS=curatarr.example.com
#CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
#CF_ACCESS_AUD=
CF_ACCESS_HOSTS=

# ── The gaming PC as a second machine (Curatarr on a NAS) ──────────────────
# The PC's tray runs an agent that reports its processes and GPU, so game
# detection keeps protecting the PC. Same token on both sides (16+ chars).
# Allow PC_AGENT_PORT in the PC's firewall for the NAS address only.
# On the PC:
#PC_AGENT_ONLY=true                          # once Curatarr runs on the NAS: the tray runs only the agent
#PC_AGENT_TOKEN=
#PC_AGENT_PORT=11435
#PC_AGENT_NOTIFY_URL=http://<nas>:<port>     # this Curatarr, for the shutdown notice
#PC_AGENT_NAME=                              # the node's name (default: its computer name)
# On the NAS:
#PC_AGENT_TOKEN=
#PC_AGENT_URL=http://<pc>:11435
# ...and to compute on the PC's card while it is on and free (chat, background
# curator work and enrichment there; deletion runs WAIT for it; embeddings
# stay here). OLLAMA_ENDPOINT stays this machine's Ollama with LLM_PROFILE /
# CURATOR_NUM_CTX / CURATOR_NUM_GPU; these describe the PC's card:
#OLLAMA_PC_ENDPOINT=http://<pc>:11434
#PC_LLM_PROFILE=large
#PC_CURATOR_NUM_CTX=0
#PC_CURATOR_NUM_GPU=99
#PC_OLLAMA_USE_MMAP=true                     # OLLAMA_USE_MMAP for the PC's Ollama
# Enrichment stays on OLLAMA_ENDPOINT so both cards work at once; true sends
# it to the PC while the PC is free.
#ENRICH_ON_PC=false
# The bases the PC's bakes are built from (python build_models.py --host pc);
# BASE_* above are OLLAMA_ENDPOINT's. "--suggest <GB>" prints the bench's pick.
#PC_BASE_CURATOR_MODEL=gemma4:31b
#PC_BASE_SUMMARIZER_MODEL=granite4.1:8b
#PC_BASE_PITCHER_MODEL=qwen3.8:27b
# Swagger/ReDoc off by default (the app binds to the LAN — /api/docs would
# hand out a map of every endpoint). Enable only for development.
ENABLE_DOCS=false
# Disk budget for the poster cache (the image proxy is unauthenticated, so a
# total cap stops a LAN client from filling the disk with variants).
IMAGE_CACHE_MAX_MB=1024

# ── Storage paths (defaults anchor to the app root; override only if you
#    know why) ─────────────────────────────────────────────────────────────
#DATABASE_URL=sqlite:///data/curatarr.db
#CHROMADB_PATH=data/chromadb
#ENRICHMENT_CACHE=data/cache/enrichment.db

# ── Process environment (NOT read from this file) ──────────────────────────
# These must be set in the environment that starts Curatarr: the first one
# says where this file is, so it cannot live in it.
#   CURATARR_ENV_FILE=/app/data/.env   where .env lives (the image sets it, so
#                                      the wizard writes into the data volume)
#   TZ=Europe/Berlin                   the server's zone, for anything not yet
#                                      tied to a user's own browser zone
#   CURATARR_LOOP_GUARD=warn           warn | raise | off: report database
#                                      calls made on the event-loop thread
#                                      (GET /api/system/loop-guard)
#   CURATARR_BUILD_SHA / _DATE         set by the image build; the version
#                                      under the sidebar and the update check
